DATABASE_URL="postgresql://stickyboard:stickyboard@localhost:5432/stickyboard"
# Docker Compose app service uses db:5432 internally.
# For local `npm run dev`, point at your Postgres (host Homebrew example above).
# If you use Compose DB with published ports, e.g. localhost:5433, update accordingly.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"
UPLOAD_DIR="./uploads"
