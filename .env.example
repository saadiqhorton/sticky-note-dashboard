# Generate a strong DB password (URL-safe): openssl rand -hex 32
POSTGRES_PASSWORD=""
# Local `npm run dev`: point at your Postgres. With the optional Compose
# overlay (docker-compose.dev.yml) use localhost:5433 and the same password.
DATABASE_URL="postgresql://stickyboard:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/stickyboard"
# Docker Compose app service builds DATABASE_URL from POSTGRES_PASSWORD and
# reaches Postgres only on the internal Compose network (db:5432).
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required in Docker / production. Bootstrap fails if unset or weak there.
# Use a unique email and a password of at least 8 chars with letters + numbers.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
UPLOAD_DIR="./uploads"
